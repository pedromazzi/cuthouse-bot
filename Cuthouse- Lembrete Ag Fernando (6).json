        "jsCode": "const startTime = $json.body.payload.startTime;\nconst nome = $json.body.payload.attendees[0].name;\nconst email = $json.body.payload.attendees[0].email;\nconst bookingUid = $json.body.payload.uid;\n\n// Extrai o número de WhatsApp do email (remove @cuthouse.com)\nconst telefone = email.replace('@cuthouse.com', '');\n\n// Calcula o horário do lembrete (1h antes do agendamento)\nconst dataAgendamento = new Date(startTime);\nconst dataLembrete = new Date(dataAgendamento.getTime() - 60 * 60 * 1000);\n\n// Formata o horário para exibir na mensagem (horário de Brasília)\nconst horarioBrasilia = dataAgendamento.toLocaleString('pt-BR', {\n  timeZone: 'America/Sao_Paulo',\n  hour: '2-digit',\n  minute: '2-digit'\n});\n\nreturn {\n  telefone,\n  nome,\n  startTime,\n  dataLembrete: dataLembrete.toISOString(),\n  horarioBrasilia,\n  bookingUid\n};"
      },
